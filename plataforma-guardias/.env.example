# =============================================================================
# Variables de entorno — copia este archivo a .env.local y complétalo.
# NUNCA subas .env.local al repositorio.
# =============================================================================

# --- Supabase (Project Settings > API) ---------------------------------------
# URL pública del proyecto. En local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Llave pública (publishable / anon). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio (service_role / secret). SOLO SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
# Se usa únicamente para crear cuentas de acceso desde Administración.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ---------------------------------------------------------------
# URL pública del sitio (enlaces de correo y redirecciones).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Zona horaria por defecto cuando una sede no define la suya.
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Mazatlan
# Muestra la franja "Datos de demostración" cuando hay filas is_demo. true/false
NEXT_PUBLIC_DEMO_MODE=true

# --- Mapa (Leaflet) ------------------------------------------------------------
# Plantilla de teselas. Los servidores de OpenStreetMap tienen una política de uso
# limitada; para producción usa un proveedor con clave o tu propio servidor.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Atribución obligatoria del proveedor de teselas (HTML permitido: enlaces).
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">Colaboradores de OpenStreetMap</a>
# Centro y zoom iniciales (Nayarit).
NEXT_PUBLIC_MAP_CENTER_LAT=21.75
NEXT_PUBLIC_MAP_CENTER_LNG=-104.85
NEXT_PUBLIC_MAP_ZOOM=8

# --- Pruebas (solo local/CI) ---------------------------------------------------
# Conexión directa a Postgres para pruebas de base de datos y RLS.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
